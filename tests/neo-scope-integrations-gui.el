;;; neo-scope-integrations-gui.el --- Isolated integration GUI -*- lexical-binding: t; -*-
(setq default-directory (file-name-directory (directory-file-name (file-name-directory load-file-name))))
(add-to-list 'load-path default-directory)
(dolist (dir '("consult-20261004.957" "orderless-20260927.2344" "vertico-20260913.1525"))
  (add-to-list 'load-path (expand-file-name dir "../emacs.d/elpa")))
(require 'neo-scope)
(require 'consult)
(require 'orderless)
(require 'vertico)
(setq neo-scope-matcher #'neo-scope-orderless-match)
(defvar scope-integration-log (expand-file-name "build/integrations-gui-result.txt"))
(defvar scope-integration-chosen nil)
(write-region "" nil scope-integration-log nil 'silent)
(defun scope-integration-check (test label)
  (unless test (error "Integration GUI: %s" label))
  (write-region (concat "PASS " label "\n") nil scope-integration-log t 'silent))
(defun scope-integration-fail (err)
  (write-region (format "FAIL %S\n" err) nil scope-integration-log t 'silent)
  (kill-emacs 1))
(defun scope-integration-vertico ()
  (let ((source (list :name "Select" :start
                      (lambda (_query emit)
                        (funcall emit 'add '((:id 1 :label "alpha") (:id 2 :label "beta")))
                        (funcall emit 'done nil) #'ignore)
                      :action (lambda (c) (setq scope-integration-chosen (plist-get c :id))))))
    (minibuffer-with-setup-hook
        (lambda ()
          (scope-integration-check (eq (key-binding (kbd "C-n")) #'vertico-next)
                                   "real Vertico minibuffer keymap")
          (insert "beta")
          (setq unread-command-events (list ?\r)))
      (neo-scope-vertico-open source))
    (scope-integration-check (= scope-integration-chosen 2) "Vertico RET selects candidate")
    (scope-integration-check (not vertico-mode) "Vertico mode restored")
    (let ((neo-scope-matcher #'neo-scope-fuzzy-match))
      (setq scope-integration-chosen nil)
      (minibuffer-with-setup-hook
          (lambda () (insert "ta be") (setq unread-command-events (list ?\r)))
        (neo-scope-vertico-open source))
      (scope-integration-check (= scope-integration-chosen 2) "Vertico fuzzy matches unordered words"))
    (setq scope-integration-chosen nil)
    (minibuffer-with-setup-hook
        (lambda () (setq unread-command-events (list ?\C-g)))
      (condition-case nil (neo-scope-vertico-open source) (quit nil)))
    (scope-integration-check (null scope-integration-chosen) "Vertico C-g skips action")
    (scope-integration-check (not vertico-mode) "Vertico cancel restores mode")))
(defun scope-integration-consult ()
  (condition-case err
      (let ((s neo-scope--session))
        (scope-integration-check (= 1 (length (neo-scope--state-matches s))) "Consult results in native screen")
        (scope-integration-check (= 2 (plist-get (plist-get (neo-scope--selected s) :value) :line)) "Consult result line")
        (with-current-buffer (neo-scope--state-preview s)
          (scope-integration-check (not (string-match-p "General" (buffer-string))) "code preview starts compact"))
        (neo-scope-toggle-details)
        (with-current-buffer (neo-scope--state-preview s)
          (scope-integration-check (string-match-p "General" (buffer-string)) "file details toggle"))
        (scope-integration-check (eq (selected-window) (neo-scope--state-input-window s)) "details retains query focus")
        (neo-scope-cancel)
        (scope-integration-vertico)
        (let ((source (neo-scope-consult-file-source (expand-file-name "build/integration-gui") t)))
          (setq source (plist-put source :action
                                  (lambda (c) (setq scope-integration-chosen
                                                    (plist-get (plist-get c :value) :line)))))
          (setq scope-integration-chosen nil)
          (minibuffer-with-setup-hook
              (lambda ()
                (insert "alpha")
                (run-at-time 0.05 nil
                             (lambda ()
                               (with-current-buffer (window-buffer (active-minibuffer-window))
                                 (let ((this-command 'self-insert-command))
                                   (goto-char (point-max)) (insert ".*beta")))))
                (run-at-time
                 0.8 nil
                 (lambda ()
                   (condition-case err
                       (with-current-buffer (window-buffer (active-minibuffer-window))
                         (let ((deadline (+ (float-time) 5)))
                           (while (and (null (all-completions "" minibuffer-completion-table))
                                       (< (float-time) deadline))
                             (accept-process-output nil 0.02)))
                         (scope-integration-check
                          (= 1 (length (all-completions "" minibuffer-completion-table)))
                          "live Consult results in one Vertico minibuffer")
                         (setq unread-command-events (list ?\r)))
                     (error (scope-integration-fail err))))))
            (neo-scope-vertico-open source))
          (scope-integration-check (= scope-integration-chosen 2) "live Vertico grep RET action"))
        (write-region "INTEGRATIONS GUI COMPLETE\n" nil scope-integration-log t 'silent)
        (kill-emacs 0))
    ((error quit) (scope-integration-fail err))))
(defun scope-integration-orderless ()
  (condition-case err
      (progn
        (scope-integration-check (= 1 (length (neo-scope--state-matches neo-scope--session))) "Orderless multiword native screen")
        (neo-scope-cancel)
        (let ((root (expand-file-name "build/integration-gui")))
          (make-directory root t)
          (with-temp-file (expand-file-name "日本.txt" root) (insert "first\nalpha beta\nalpha gamma\n"))
          (neo-scope-open (neo-scope-consult-file-source root t))
          (with-current-buffer (neo-scope--state-input neo-scope--session) (insert "alpha.*beta")))
        (run-at-time 1 nil #'scope-integration-consult))
    (error (scope-integration-fail err))))
(run-at-time
 0.5 nil
 (lambda ()
   (condition-case err
       (progn
         (set-frame-size (selected-frame) 130 40)
         (neo-scope-open
          (list :name "Orderless" :start
                (lambda (_query emit)
                  (funcall emit 'add '((:id 1 :label "alpha beta" :match "alpha beta")
                                      (:id 2 :label "alpha" :match "alpha")))
                  (funcall emit 'done nil) #'ignore)))
         (with-current-buffer (neo-scope--state-input neo-scope--session) (insert "beta alpha"))
         (run-at-time 0.5 nil #'scope-integration-orderless))
     (error (scope-integration-fail err)))))
