;;; neo-scope-embark-gui.el --- Isolated Consult handoff smoke test -*- lexical-binding: t; -*-
(setq default-directory (file-name-directory (directory-file-name (file-name-directory load-file-name)))
      load-prefer-newer t native-comp-jit-compilation nil
      temporary-file-directory (expand-file-name "build/embark-grep/" default-directory)
      user-emacs-directory temporary-file-directory auto-save-list-file-prefix nil)
(add-to-list 'load-path default-directory)
(dolist (dir (directory-files "../emacs.d/elpa" t "\\`\\(?:embark\\|embark-consult\\|consult\\|vertico\\)-"))
  (add-to-list 'load-path dir))
(require 'neo-scope-embark)
(require 'consult)
(require 'embark-consult)
(require 'vertico)
(vertico-mode 1)
(neo-scope-embark-setup)
(global-set-key (kbd "C-.") #'embark-act)
(setq embark-confirm-act-all nil embark-prompter #'embark-keymap-prompter
      completion-styles '(substring basic))
(defvar scope-handoff-log (expand-file-name "gui.log" temporary-file-directory))
(defvar scope-handoff-origin nil)
(defvar scope-handoff-layout nil)
(defvar scope-handoff-root nil)
(write-region "" nil scope-handoff-log nil 'silent)
(defun scope-handoff-check (test label)
  (unless test (error "Handoff GUI: %s" label))
  (write-region (concat "PASS " label "\n") nil scope-handoff-log t 'silent))
(defun scope-handoff-fail (err)
  (write-region (format "FAIL %S\n" err) nil scope-handoff-log t 'silent)
  (kill-emacs 1))
(defun scope-handoff-keys ()
  (execute-kbd-macro (kbd "C-. A N")))
(defun scope-handoff-search-line (next)
  (minibuffer-with-setup-hook
      (lambda () (insert "alpha") (run-at-time 0.2 nil #'scope-handoff-keys))
    (condition-case nil (consult-line) (quit nil)))
  (run-at-time 0.4 nil next))
(defun scope-handoff-filter ()
  (condition-case err
      (let ((s neo-scope--session))
        (scope-handoff-check (not (active-minibuffer-window)) "Consult minibuffer closed")
        (scope-handoff-check (= 2 (length (neo-scope--state-matches s))) "filtered Consult list transferred")
        (scope-handoff-check (string-empty-p (neo-scope--state-query s)) "new query starts empty")
        (scope-handoff-check (eq (selected-window) (neo-scope--state-input-window s)) "input receives focus")
        (execute-kbd-macro "gamma")
        (run-at-time 0.4 nil #'scope-handoff-accept))
    (error (scope-handoff-fail err))))
(defun scope-handoff-accept ()
  (condition-case err
      (let ((s neo-scope--session))
        (scope-handoff-check (= 1 (length (neo-scope--state-matches s))) "additional filtering works")
        (with-current-buffer (neo-scope--state-preview s)
          (scope-handoff-check (string-match-p "alpha gamma" (buffer-string)) "unsaved content previewed"))
        (execute-kbd-macro (kbd "RET"))
        (scope-handoff-check (null neo-scope--session) "RET closes finder")
        (scope-handoff-check (eq (current-buffer) scope-handoff-origin) "RET returns to original buffer")
        (scope-handoff-check (= 3 (line-number-at-pos)) "RET visits selected Consult line")
        (setq scope-handoff-layout (current-window-configuration))
        (scope-handoff-search-line #'scope-handoff-cancel))
    (error (scope-handoff-fail err))))
(defun scope-handoff-cancel ()
  (condition-case err
      (progn
        (scope-handoff-check neo-scope--session "second handoff opens")
        (execute-kbd-macro (kbd "C-g"))
        (scope-handoff-check (null neo-scope--session) "C-g cancels finder")
        (scope-handoff-check (compare-window-configurations scope-handoff-layout (current-window-configuration))
                             "cancel restores windows and point")
        (setq scope-handoff-root (make-temp-file "scope-gui-" t))
        (let ((coding-system-for-write 'utf-8-unix))
          (with-temp-file (expand-file-name "日本 file.txt" scope-handoff-root)
            (insert "first\nprefix alpha beta\nprefix alpha gamma\n")))
        (minibuffer-with-setup-hook
            (lambda () (run-at-time 0.8 nil #'scope-handoff-keys))
          (condition-case nil (consult-ripgrep scope-handoff-root "alpha") (quit nil)))
        (run-at-time 0.4 nil #'scope-handoff-grep))
    (error (scope-handoff-fail err))))
(defun scope-handoff-grep ()
  (condition-case err
      (let ((s neo-scope--session))
        (scope-handoff-check (= 2 (length (neo-scope--state-matches s))) "real Consult ripgrep list transferred")
        (execute-kbd-macro "gamma")
        (run-at-time
         0.4 nil
         (lambda ()
           (condition-case err
               (progn
                 (execute-kbd-macro (kbd "RET"))
                 (scope-handoff-check (equal (file-truename (buffer-file-name))
                                             (file-truename (expand-file-name "日本 file.txt" scope-handoff-root)))
                                      "grep opens original file")
                 (scope-handoff-check (and (= 3 (line-number-at-pos)) (looking-at "alpha"))
                                      "grep preserves line and match column")
                 (kill-buffer (current-buffer))
                 (delete-directory scope-handoff-root t)
                 (write-region "GUI COMPLETE\n" nil scope-handoff-log t 'silent)
                 (kill-emacs 0))
             (error (scope-handoff-fail err))))))
    (error (scope-handoff-fail err))))
(run-at-time 20 nil
             (lambda ()
               (write-region (with-current-buffer "*Messages*" (buffer-string))
                             nil scope-handoff-log t 'silent)
               (scope-handoff-fail "timeout")))
(run-at-time
 0.3 nil
 (lambda ()
   (condition-case err
       (progn
         (set-frame-size (selected-frame) 130 40)
         (switch-to-buffer (generate-new-buffer "scope-unsaved-gui"))
         (setq scope-handoff-origin (current-buffer))
         (insert "heading\nprefix alpha beta\nprefix alpha gamma\nomega\n")
         (goto-char 1)
         (split-window-right)
         (scope-handoff-search-line #'scope-handoff-filter))
     (error (scope-handoff-fail err)))))
