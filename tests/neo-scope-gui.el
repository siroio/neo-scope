;;; neo-scope-gui.el --- Isolated GUI smoke test -*- lexical-binding: t; -*-
(setq default-directory (file-name-directory (directory-file-name (file-name-directory load-file-name))))
(add-to-list 'load-path default-directory)
(require 'neo-scope)
(dolist (dir '("evil-20260728.1438" "goto-chg-20240407.1110"))
  (add-to-list 'load-path (expand-file-name dir "../emacs.d/elpa")))
(require 'evil)
(evil-mode 1)
(defvar neo-scope-gui-log (expand-file-name "build/gui-result.txt" default-directory))
(write-region "" nil neo-scope-gui-log nil 'silent)
(defvar neo-scope-gui-parent nil)
(defvar neo-scope-gui-source nil)
(defvar neo-scope-gui-chosen nil)
(defvar neo-scope-gui-saved nil)
(defvar neo-scope-gui-origin nil)
(defun neo-scope-gui-check (value description)
  (unless value (error "GUI assertion: %s" description))
  (write-region (concat "PASS " description "\n") nil neo-scope-gui-log t 'silent))
(defun neo-scope-gui-fail (err)
  (write-region (format "FAIL %S\n" err) nil neo-scope-gui-log t 'silent)
  (kill-emacs 1))
(defun neo-scope-gui-step-2 ()
  (condition-case err
      (let* ((s neo-scope--session) (frame (neo-scope--state-frame s)))
        (neo-scope-gui-check (eq frame neo-scope-gui-parent) "uses original frame")
        (neo-scope-gui-check (= 3 (length (window-list frame 'no-minibuffer))) "three panels")
        (neo-scope-gui-check (= 2 (length (neo-scope--state-matches s))) "initial results")
        (select-window (neo-scope--state-input-window s))
        (neo-scope-gui-check (eq evil-state 'emacs) "query accepts immediate typing under Evil")
        (execute-kbd-macro "be ta")
        (run-at-time 0.6 nil #'neo-scope-gui-step-3))
    (error (neo-scope-gui-fail err))))
(defun neo-scope-gui-step-3 ()
  (condition-case err
      (let ((s neo-scope--session))
        (neo-scope-gui-check (= 1 (length (neo-scope--state-matches s))) "typed query filters")
        (neo-scope-gui-check (equal "beta" (plist-get (neo-scope--selected s) :id)) "correct selected candidate")
        (neo-scope-accept)
        (neo-scope-gui-check (equal neo-scope-gui-chosen "beta") "RET action")
        (neo-scope-gui-check (null neo-scope--session) "session removed")
        (neo-scope-gui-check (not (buffer-live-p (neo-scope--state-input s))) "input cleaned")
        (neo-scope-gui-check (eq (selected-frame) neo-scope-gui-parent) "parent focus restored")
        (neo-scope-gui-check (eq (selected-window) neo-scope-gui-origin) "origin window restored")
        (neo-scope-gui-check evil-local-mode "origin Evil mode preserved")
        (neo-scope-gui-check (equal neo-scope-gui-saved
                                   (list (window-buffer) (window-point) (window-start)
                                         (length (window-list)))) "origin contents and layout restored")
        (neo-scope-open neo-scope-gui-source)
        (select-window (neo-scope--state-preview-window neo-scope--session))
        (call-interactively (key-binding (kbd "C-g")))
        (neo-scope-gui-check (null neo-scope--session) "cancel reopened finder")
        (setq s (neo-scope-open neo-scope-gui-source))
        (select-window (neo-scope--state-list-window s))
        (call-interactively (key-binding (kbd "q")))
        (neo-scope-gui-check (null neo-scope--session) "q closes whole finder")
        (setq s (neo-scope-open neo-scope-gui-source))
        (select-window (neo-scope--state-input-window s))
        (call-interactively (command-remapping 'quit-window))
        (neo-scope-gui-check (null neo-scope--session) "quit-window command remap closes finder")
        (dolist (accessor '(neo-scope--state-input neo-scope--state-candidates neo-scope--state-preview))
          (setq s (neo-scope-open neo-scope-gui-source))
          (with-current-buffer (neo-scope--state-preview s) (fundamental-mode))
          (kill-buffer (funcall accessor s))
          (neo-scope-gui-check (null neo-scope--session) "killing any panel closes session")
          (neo-scope-gui-check
           (not (cl-some #'buffer-live-p (list (neo-scope--state-input s)
                                              (neo-scope--state-candidates s)
                                              (neo-scope--state-preview s)))) "all panels cleaned")
          (neo-scope-gui-check (equal neo-scope-gui-saved
                                     (list (window-buffer) (window-point) (window-start)
                                           (length (window-list)))) "split layout restored after kill"))
        (setq s (neo-scope-open neo-scope-gui-source))
        (set-frame-size neo-scope-gui-parent 110 35)
        (neo-scope--parent-resized neo-scope-gui-parent)
        (neo-scope-gui-check (frame-live-p (neo-scope--state-frame s)) "parent resize")
        (neo-scope-cancel)
        (let ((extra-parent (make-frame '((width . 90) (height . 30)))))
          (select-frame-set-input-focus extra-parent)
          (setq s (neo-scope-open neo-scope-gui-source))
          (delete-frame extra-parent t)
          (neo-scope-gui-check (null neo-scope--session) "parent deletion cleans session")
          (neo-scope-gui-check (not (buffer-live-p (neo-scope--state-preview s))) "parent deletion cleans preview"))
        (write-region "GUI COMPLETE\n" nil neo-scope-gui-log t 'silent)
        (kill-emacs 0))
    (error (neo-scope-gui-fail err))))
(run-at-time
 0.5 nil
 (lambda ()
   (condition-case err
       (progn
         (setq neo-scope-gui-parent (selected-frame))
         (set-frame-size neo-scope-gui-parent 130 40)
         (split-window-right)
         (setq neo-scope-gui-origin (selected-window)
               neo-scope-gui-saved (list (window-buffer) (window-point) (window-start)
                                        (length (window-list)))
               neo-scope-gui-source
               (list :name "GUI test"
                     :start (lambda (_query emit)
                              (funcall emit 'add
                                       (mapcar (lambda (name) (list :id name :label name :match name :value name))
                                               '("alpha" "beta")))
                              (funcall emit 'done nil) #'ignore)
                     :preview (lambda (c b) (with-current-buffer b (let ((inhibit-read-only t)) (erase-buffer) (insert (plist-get c :label)))))
                     :action (lambda (c) (setq neo-scope-gui-chosen (plist-get c :id)))))
         (neo-scope-open neo-scope-gui-source)
         (run-at-time 0.6 nil #'neo-scope-gui-step-2))
     (error (neo-scope-gui-fail err)))))
